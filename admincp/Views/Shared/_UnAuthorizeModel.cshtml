@{
    Layout = "~/Views/Shared/_RenderLayout.cshtml";
    ViewBag.Title = "Đăng Nhập";
}
<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
    <h4 class="modal-title">@ViewBag.Title</h4>
</div>
<div class="modal-body">
    <!-- Warning Alert -->
    <div class="alert alert-warning">
        <p>Vui lòng đăng nhập để sử dụng Tool này</p>
        <p>Refresh trang để đăng nhập.</p>        
    </div>
    <!-- END Warning Alert -->
    <div class="form-actions">
        <div class="text-right">
            @Html.ActionLink("Đăng Nhập", "Login", "Account", routeValues: null, htmlAttributes: new { id = "login-link", @class = "btn btn-sm btn-success" })
            <button type="button" class="btn btn-sm btn-success" data-dismiss="modal">Hủy</button>
        </div>
    </div>
</div>
