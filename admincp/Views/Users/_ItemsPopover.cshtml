@model SqlDataProvider.Data.ItemInfo
@{
    Layout = null;
    var item = Model;
    string prop = string.Empty;
    string addBlood = string.Empty;
    if (item.Template != null)
    {
        switch (item.Template.CategoryID)
        {
            case 1:
            case 5:
                prop = "Hộ giáp";
                break;
            case 27:
            case 7:
                prop = "Sát thương";
                break;
            case 17:
            case 31:
                if (item.Template.Property3 == 31)
                {
                    prop = "giảm thiệt hại";
                }
                else
                {
                    prop = "hồi phục";
                }
                break;
        }
        if (item.Template.CategoryID == 14)
        {
            addBlood = item.Template.Property1 + "%";
        }
    }
}

   @if (item == null)
   {
    <div class="text-center">
        @Html.Raw(StaticFunction.GetTranslation("Views.Empty"))
    </div>
   }
   else
   {
    <table class="table table-borderless table-striped table-vcenter">
        <tbody> 
             @if (item.StrengthenLevel > 0)
             {
                <tr>
                    <td class="text-right"><strong>Cấp độ</strong></td>
                    <td style="width:155px">
                        <span class="text-danger"><strong>@item.StrengthenLevel</strong></span>
                    </td>
                </tr>
             }
            @if (item.Template != null && !string.IsNullOrEmpty(prop))
            {
                <tr>
                    <td class="text-right"><strong>@prop</strong></td>
                    <td class="text-success">@item.Template.Property7 (+@StaticFunction.getHertAddition(item.Template.Property7, item.StrengthenLevel))</td>
                </tr>
            }
            @if (item.IsGold)
            {
                <tr>
                    <td class="text-right"><strong>Đúc vàng</strong></td>
                    <td>
						@if (item.goldValidDate == 0)
						{
							<span class="text-success">Vĩnh viễn</span>
						}
						else
						{
							<span class="text-success">Hiệu lực đúc vàng: @item.goldValidDate ngày</span>
						}
					</td>
                </tr>
            }
             @if (item.Template != null && item.Template.NeedSex > 0)
             {
                <tr>
                    <td class="text-right"><strong>Giới tính</strong></td>
                    <td>
					@switch (item.Template.NeedSex)
					{
						case 0:
							<span class="text-muted">Giới tính không</span>
							break;
						case 1:
							<span class="text-muted">Nam</span>
							break;
						case 2:
							<span class="text-muted">Nữ</span>
							break;
					}
					</td>
                </tr>
             }
            <tr>
                <td class="text-right"><strong>Phầm chất</strong></td>
                <td>
				@switch (item.Template.Quality)
				{
                    case 1:
                        <span class="text-muted">Thô</span>
                        break;
                    case 2:
                        <span style="color:#006600">Thường</span>
                        break;
                    case 3:
                        <span style="color:#0000FF">Ưu tú</span>
                        break;
                    case 4:
                        <span style="color:#990099">Hoàn mỹ</span>
                        break;
                    case 5:
                        <span style="color:#FF9900">Siêu việt</span>
                        break;
                    case 6:
                        <span style="color:#FF33FF">Truyền thuyết</span>
                        break;
                    case 7:
                        <span style="color:#33CCCC">Hiện vật</span>
                        break;
                }
				</td>
            </tr>
            @if (!string.IsNullOrEmpty(addBlood))
            {
                <tr>
                    <td class="text-right"><strong>HP</strong></td>
                    <td class="text-success">@addBlood</td>
                </tr>
            }
            <tr>
                <td class="text-right"><strong>Tấn công</strong></td>
                <td>@item.Attack</td>
            </tr>
            <tr>
                <td class="text-right"><strong>Phòng thủ</strong></td>
                <td>@item.Defence</td>
            </tr>
            <tr>
                <td class="text-right"><strong>Nhanh nhẹn</strong></td>
                <td>@item.Agility</td>
            </tr>
            <tr>
                <td class="text-right"><strong>May mắn</strong></td>
                <td>@item.Luck</td>
            </tr>
            <tr>
                <td class="text-right"><strong>Ma công</strong></td>
                <td>@item.MagicAttack</td>
            </tr>
            <tr>
                <td class="text-right"><strong>Ma kháng</strong></td>
                <td>@item.MagicDefence</td>
            </tr>            
        </tbody>
    </table>
   }