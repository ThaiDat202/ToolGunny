<!-- Metro Notification JS -->
<script src="@StaticFunction.Host("Scripts/MetroNotification.js")"></script>
<script>
    $(function () {
        // Tham chiếu proxy tự động tạo cho hub.
        var chat = $.connection.chatHub;
        // Tạo một hàm để hub gọi lại và hiển thị tin nhắn.
        chat.client.addNewMessageToPage = function (name, message) {
            // Thêm tin nhắn vào trang.
            $.bigBox({
                title: name, // Tùy chỉnh tên của bạn ở đây! Ví dụ: GM
                content: message,
                soundpath: '@StaticFunction.Host("Backend/static/sound")'
            });
        };

        // Lấy tên người dùng và lưu lại để thêm vào tin nhắn
        $('#identityName').val('@User.Identity.Name');
        // Thiết lập tiêu điểm ban đầu cho hộp nhập tin nhắn.

        // Bắt đầu kết nối.
        $.connection.hub.start()
            .done(function () {
                console.log('Đã kết nối, ID kết nối=' + $.connection.hub.id);

                $('#sendmessage').click(function () {
                    // Gọi phương thức Send trên hub.
                    var name = $('#identityName').val();
                    console.log('name=' + name);
                    var message = CKEDITOR.instances.message.getData();
                    if (message !== "") {
                        chat.server.send('@StaticFunction.CryptoToken(User.Identity.Name)', name, message);
                    }
                });
                /*KẾT THÚC*/
            })
        .fail(function () { console.log('Không thể kết nối!'); });
    });
</script>
}