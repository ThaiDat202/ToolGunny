<link rel="stylesheet" type="text/css" href="@StaticFunction.Host("Backend/css/MetroNotificationStyle.min.css")">
<!-- Tiêu đề thay thế trống -->
<div class="content-header">
    <div class="header-section">
        <h1>
            <i class="gi gi-brush"></i>Thông báo toàn cầu trực tiếp<br><small>Chức năng thông báo trực tiếp rất tuyệt vời.</small>
        </h1>
    </div>
</div>
<ul class="breadcrumb breadcrumb-top">
    <li>Trang chủ</li>
    <li>Trang đầu</li>
    <li><a href="">Thông báo toàn cầu trực tiếp</a></li>
</ul>
<!-- Kết thúc tiêu đề thay thế trống -->
<!-- Nội dung thay thế trống -->
<div class="block block-alt-noborder">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <textarea id="message" name="message" rows="13" class="ckeditor" placeholder="Nội dung.."></textarea>
                <input type="hidden" id="identityName" />
            </div>
            <div class="form-group text-right">
                <button type="submit" class="btn btn-primary" id="sendmessage"><i class="fa fa-mail-forward"></i>Gửi thông báo trực tiếp</button>
            </div>
        </div>
    </div>
</div>
<!-- Kết thúc nội dung thay thế trống -->
<!-- Nội dung -->
<div class="block block-alt-noborder">
    <h3 class="sub-header">Thêm đoạn mã sau vào<small>trang web của bạn cho chức năng này</small></h3>
    <!-- HTML -->
    <pre class="line-numbers">
    <code class="language-markup">
                &lt;!-- Font Awesome v4.2. Lưu ý: Nếu trang của bạn không hiển thị biểu tượng, bạn phải sao chép font-awesome vào trang web của mình và thay đổi @StaticFunction.Host("") thành tên miền của bạn--&gt;
                &lt;link rel=&quot;stylesheet&quot; type=&quot;text/css&quot; href=&quot;@StaticFunction.Host("Backend/css/fonts/font-awesome.min.css")&quot;&gt;
                &lt;!-- Kiểu thông báo Metro --&gt;
            	&lt;link rel=&quot;stylesheet&quot; type=&quot;text/css&quot; href=&quot;@StaticFunction.Host("Backend/css/MetroNotificationStyle.min.css")&quot;&gt;
				
            &lt;!--Thư viện jQuery 
            &lt;script src=&quot;@StaticFunction.Host("http://103.216.155.126:83//Backend/js/vendor/jquery-1.11.3.min.js?1")&quot;&gt;&lt;/script&gt;
            --&gt;
            &lt;!--Tham chiếu thư viện SignalR. --&gt;
            &lt;script src=&quot;@StaticFunction.Host("Scripts/jquery.signalR-2.2.0.min.js")&quot;&gt;&lt;/script&gt;
            &lt;!--Tham chiếu script hub SignalR được tự động tạo. --&gt;
            &lt;script src=&quot;@StaticFunction.Host("signalr/hubs")&quot;&gt;&lt;/script&gt;

            &lt;!-- Metro Notification JS --&gt;
            &lt;script src=&quot;@StaticFunction.Host("Scripts/MetroNotification.js")&quot;&gt;&lt;/script&gt;
            &lt;script type=&quot;text/javascript&quot;&gt;
                $(function () {
                    // Tham chiếu proxy tự động tạo cho hub.
                    var chat = $.connection.chatHub;
                    // Tạo một hàm để hub gọi lại và hiển thị tin nhắn.
                    chat.client.addNewMessageToPage = function (name, message) {
                        // Thêm tin nhắn vào trang sử dụng Metro Notification
                        if(message=='shutdown'){
                           window.location.replace("@StaticFunction.Host("maintenance")");
                        }
                        else{
                            $.bigBox({
                                title: name,//Tùy chỉnh tên của bạn ở đây! Ví dụ: GM
                                content: message,
                                soundpath: '@StaticFunction.Host("Backend/static/sound")'
                            });
                        }
                    };  
                    $.connection.hub.url = "@StaticFunction.Host("signalr")";
                    $.connection.hub.start()
					 .done(function(){ console.log('Đã kết nối, ID kết nối=' + $.connection.hub.id); })
					 .fail(function(){ console.log('Không thể kết nối!'); });	         
                });        
            &lt;/script&gt;
    </code>
</pre>
<!-- Kết thúc HTML -->
</div>
