@using GM.Service.Models;
@model TopAwardModel
@{
    Layout = "~/Views/Shared/_RenderLayout.cshtml";
    var item = Model.Award;
}

   <div class="ajax-text-and-image white-popup-block">
    <style>
	.ajax-text-and-image {
		max-width:800px; margin: 20px auto; background: #FFF; padding: 0; line-height: 0;
	}	
    </style>
    <!--Avatar -->
       @Html.Partial("Avatar", Model.Avatar)
    <!--END Avatar-->
     <div class="ajcol" style="line-height: 1.231;">
         <div class="block" style="margin-top:15px; width:384px; position:relative;">
             <div class="block-title clearfix">
                 <div class="block-options">
                     View props<i class="gi gi-chevron-right" style="font-size:8px"></i><span class="text-warning"><strong> @item.Name</strong>< /span>
                 </div>
             </div>
             <div class="block-content-full">
                 <table class="table table-borderless table-striped table-vcenter">
                     <tbody>
                         <tr>
                             <td class="text-right" style="width:150px"><strong>Expiry date</strong></td>
                             <td>
                             @if (item. ValidDate == 0)
                             { <span class="text-success"> Permanent </span> }
                             else
                             { <span class="text-info">@item.ValidDate days</span> }
                             </td>
                         </tr>
                         <tr>
                             <td class="text-right" style="width:150px"><strong>Whether to bind</strong></td>
                             <td>
                                 @if(!item.IsBinds)
                                 { <span class="text-success"> binding</span> }
                                 else
                                 { <span class="text-danger"> unbound</span> }
                             </td>
                         </tr>
                         <tr>
                             <td class="text-right" style="width:150px"><strong>Enhancement level</strong></td>
                             <td>
                             @if (item. StrengthLevel == 0)
                             { <span class="text-muted"> Not Muted</span> }
                             else
                             { <span class="text-info">Strengthen: @item.StrengthenLevel level</span> }
                             </td>
                         </tr>
                         <tr>
                             <td class="text-right"><strong>Attack Synthesis</strong></td>
                             <td>@item. AttackCompose</td>
                         </tr>
                         <tr>
                             <td class="text-right"><strong>Defense Synthesis</strong></td>
                             <td>@item.DefendCompose</td>
                         </tr>
                         <tr>
                             <td class="text-right"><strong>Agile Synthesis</strong></td>
                             <td>@item.AgilityCompose</td>
                         </tr>
                         <tr>
                             <td class="text-right"><strong>Lucky Synthesis</strong></td>
                             <td>@item.LuckCompose</td>
                         </tr>
                         <tr>
                             <td class="text-right"><strong>Magic attack</strong></td>
                             <td>@item.MagicAttack</td>
                         </tr>
                         <tr>
                             <td class="text-right"><strong>Magic Defense</strong></td>
                             <td>@item.MagicDefend</td>
                         </tr>
                         <tr>
                             <td class="text-right"><strong>Whether to cast gold</strong></td>
                             <td>@if (item.IsGold) { <span class="text-success">Validity:</span><span> </span><span>@item.GoldValidate days</span> }
                             else
                             { <span class="text-muted" >uncast gold</span>} </td>
                         </tr>
                     </tbody>
                 </table>
             </div>
             <div class="pull-right" style="position:absolute; bottom:0px; right:20px">@Html.ItemImage(item.TemplateID, "thumbnail", "thumbnail", "auto")</div>
         </div>
         <span class="text-warning">*An error occurred</span>
     </div>
     <div style="clear:both; line-height: 0;"></div>
</div>
@section Scripts{
    <script>       
        $(function () {
            /**/
        });
    </script>
}

